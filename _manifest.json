{
  "manifest_version": 2,
  "id": "org.orge-8.qzone-feeds",
  "version": "1.0.0",
  "name": "QQ空间动态",
  "description": "发QQ动态、读好友动态、VLM识别动态配图、回复自己动态下的评论、定时自动读好友动态并点赞评论（自动任务带静默时段与概率控制）。所有命令需管理员鉴权，Cookie 通过 napcat-adapter 自动获取，全局限速串行队列防风控。",
  "author": {
    "name": "orge-8",
    "url": "https://github.com/orge-8"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/orge-8/qzone-feeds"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    { "type": "plugin", "id": "maibot-team.napcat-adapter", "version_spec": ">=0.1.0" },
    { "type": "python_package", "name": "httpx", "version_spec": ">=0.27" },
    { "type": "python_package", "name": "beautifulsoup4", "version_spec": ">=4.0" },
    { "type": "python_package", "name": "json5", "version_spec": ">=0.0.1" },
    { "type": "python_package", "name": "pillow", "version_spec": ">=10.0" }
  ],
  "capabilities": [
    "send.text",
    "llm.generate",
    "api.call"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
